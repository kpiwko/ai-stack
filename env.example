# local-ai compose — environment variables template
# Copy to .env and fill in your secrets.  NEVER commit .env — it is gitignored.
#
# Generate random secret keys with:  openssl rand -hex 16

###############################################################################
# Gmail MCP  (OAuth client from Google Cloud Console → APIs & Services → Credentials)
###############################################################################
GMAIL_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=<your-client-secret>

###############################################################################
# AI Beacon
###############################################################################
AI_BEACON_AUTH_PASSWORD=demo

###############################################################################
# DevLake MCP  (connects to DevLake MySQL published on host port 3306)
# DEVLAKE_MYSQL_USER / PASSWORD must match what DevLake is configured with.
# DEVLAKE_MCP_SECRET_KEY authenticates MCP HTTP calls.
###############################################################################
DEVLAKE_MYSQL_USER=merico
DEVLAKE_MYSQL_PASSWORD=merico
DEVLAKE_MCP_SECRET_KEY=<openssl rand -hex 16>

###############################################################################
# Konflux MCP  (remote read-only RDS connection)
###############################################################################
KONFLUX_MYSQL_HOST=<rds-endpoint.region.rds.amazonaws.com>
KONFLUX_MYSQL_PORT=3306
KONFLUX_MYSQL_USER=<db-user>
KONFLUX_MYSQL_PASS=<db-password>
KONFLUX_MYSQL_DB=lake
KONFLUX_MCP_SECRET_KEY=<openssl rand -hex 16>

###############################################################################
# gdrive-mcp  (persistent HTTP service on port 17100)
#
# No secrets needed here — credentials come from bind-mounted host files:
#   ~/.config/google-drive-mcp/credentials.json  (OAuth client, read-only)
#   ~/.config/google-drive-mcp/tokens.json        (OAuth token, read-write)
#
# Authenticate on the host before first run:
#   npx @piotr-agier/google-drive-mcp auth
#
# Register with Claude Code once the container is running:
#   claude mcp add --transport http --scope user gdrive http://localhost:17100/mcp
###############################################################################

###############################################################################
# mcp-atlassian  (persistent HTTP service on port 17000)
#
# JIRA_API_TOKEN — personal access token from:
#   https://redhat.atlassian.net/secure/ViewProfile.jspa?selectedTab=com.atlassian.pats.pats-plugin:jira-user-personal-access-tokens-page
#
# Register with Claude Code once the container is running:
#   claude mcp add --transport http --scope user mcp-atlassian http://localhost:17000/mcp
###############################################################################
JIRA_URL=https://redhat.atlassian.net
JIRA_USERNAME=<your-email@redhat.com>
JIRA_API_TOKEN=<your-personal-access-token>
